{
  "manifest_version": 3,
  "name": "DMDB",
  "version": "0.3.0",
  "description": "A searchable database of your Instagram web DMs: backs them up locally, keeps them even if Instagram drops them, and shows exact timestamps. Not affiliated with Instagram or Meta.",
  "permissions": [
    "unlimitedStorage",
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "parse.js",
        "bridge.js",
        "ui.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open DMDB",
    "default_icon": {
      "16": "icons/dmdb-16.png",
      "32": "icons/dmdb-32.png"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/dmdb-16.png",
    "32": "icons/dmdb-32.png",
    "48": "icons/dmdb-48.png",
    "128": "icons/dmdb-128.png"
  }
}
